{
  "name": "gitchat-native",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "dev": "npm run prepare:desktop && tauri dev",
    "build": "npm run prepare:desktop && tauri build",
    "android:init": "tauri android init --ci",
    "android:build": "tauri android build --debug --apk",
    "ios:init": "tauri ios init --ci",
    "ios:build": "tauri ios build --debug --target aarch64-sim --no-sign --archive-only",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "playwright": "1.56.1"
  }
}
