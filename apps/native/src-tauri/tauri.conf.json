{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "求知",
  "version": "0.2.0",
  "identifier": "com.gitchat.qiuzhi",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": ["launcher"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "把思考展开成卡片",
    "longDescription": "在独立的卡片中深入、发散、回溯与合并，让你主导每一步思考。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0" },
    "iOS": { "minimumSystemVersion": "16.4" },
    "android": { "minSdkVersion": 26 },
    "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["SimpChinese", "English"] } }
  }
}
